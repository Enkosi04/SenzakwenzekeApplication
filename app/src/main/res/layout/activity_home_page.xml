<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- LUXURY HERO -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="300dp" android:orientation="vertical" android:background="#0D2A6E" android:gravity="center" android:padding="20dp">
            <TextView android:id="@+id/tvWelcomeUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="8dp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EST. 2024 • BOTHAS HILL, DURBAN" android:textSize="9sp" android:textColor="#C9982E" android:letterSpacing="0.2" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Senzakwenzeke" android:textSize="36sp" android:textStyle="bold" android:textColor="#FFD700" android:fontFamily="serif" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Elegant Decor &amp; Catering" android:textSize="18sp" android:textColor="#FFFFFF" android:gravity="center" android:layout_marginTop="4dp"/>
            <View android:layout_width="60dp" android:layout_height="2dp" android:background="#C9982E" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="280dp" android:layout_height="wrap_content" android:text="We Make It Happen — Turning your dream events into reality with authentic Zulu tradition and modern elegance." android:textSize="11sp" android:textColor="#E0E0E0" android:gravity="center" android:lineSpacingExtra="3dp"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp" android:gravity="center">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBookNow" android:layout_width="140dp" android:layout_height="50dp" android:text="BOOK NOW" android:textSize="11sp" android:textStyle="bold" android:textColor="#0D2A6E" app:cornerRadius="25dp" android:backgroundTint="#C9982E"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnExplore" android:layout_width="120dp" android:layout_height="50dp" android:layout_marginStart="12dp" android:text="EXPLORE" android:textSize="11sp" android:textColor="#FFFFFF" app:cornerRadius="25dp" android:backgroundTint="#0D2A6E" app:strokeColor="#FFFFFF" app:strokeWidth="1dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- STATS BAR -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:orientation="horizontal" android:background="#FFFFFF" android:gravity="center" android:elevation="4dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500+" android:textSize="18sp" android:textStyle="bold" android:textColor="#0D2A6E"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Events Managed" android:textSize="8sp" android:textColor="#888888" android:textStyle="bold"/></LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#EEEEEE"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.9 ★" android:textSize="18sp" android:textStyle="bold" android:textColor="#0D2A6E"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Client Rating" android:textSize="8sp" android:textColor="#888888" android:textStyle="bold"/></LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#EEEEEE"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textSize="18sp" android:textStyle="bold" android:textColor="#0D2A6E"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Female Owned" android:textSize="8sp" android:textColor="#888888" android:textStyle="bold"/></LinearLayout>
        </LinearLayout>

        <!-- PREVIEW SECTION -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OUR HERITAGE" android:textSize="9sp" android:textColor="#C9982E" android:textStyle="bold" android:letterSpacing="0.15"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Professional &amp; Traditional" android:textSize="20sp" android:textStyle="bold" android:textColor="#0D2A6E" android:layout_marginTop="2dp" android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="4dp" android:layout_marginBottom="20dp" app:strokeColor="#0D2A6E" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Why Senzakwenzeke?" android:textSize="16sp" android:textStyle="bold" android:textColor="#0D2A6E"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Based in Bothas Hill, we serve the greater Durban area with excellence in every plate and every drape." android:textSize="12sp" android:textColor="#666666" android:layout_marginTop="8dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✓ 24/7 Support\n✓ Custom Themes\n✓ Expert Chefs" android:textSize="10sp" android:textColor="#0D2A6E" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✓ Fast Setup\n✓ Reliable Team\n✓ Verified Reviews" android:textSize="10sp" android:textColor="#0D2A6E" android:textStyle="bold"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGoBooking" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:text="GET A FREE QUOTE" android:textSize="12sp" android:textStyle="bold" app:cornerRadius="12dp" android:backgroundTint="#0D2A6E" android:textColor="#FFD700"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- SOCIAL MEDIA SECTION -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="#FFFFFF">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECT WITH US" android:textSize="10sp" android:textColor="#C9982E" android:textStyle="bold" android:letterSpacing="0.2"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFacebookH"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FACEBOOK"
                    android:textSize="10sp"
                    android:textColor="#0D2A6E"
                    app:strokeColor="#0D2A6E"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstagramH"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTAGRAM"
                    android:textSize="10sp"
                    android:textColor="#0D2A6E"
                    app:strokeColor="#0D2A6E"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsAppH"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHATSAPP"
                    android:textSize="10sp"
                    android:textColor="#25D366"
                    app:strokeColor="#25D366"/>

            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="© 2026 Senzakwenzeke (Pty) Ltd • Bothas Hill • POPIA Compliant" android:textSize="8sp" android:textColor="#999999" android:gravity="center" android:padding="20dp"/>
    </LinearLayout>
</ScrollView>
