<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2A6E">

    <!-- UNIQUE LOGO DESIGN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <androidx.cardview.widget.CardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#C9982E"
            app:strokeWidth="4dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SZ"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#0D2A6E"
                    android:fontFamily="serif"
                    android:layout_centerInParent="true"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#C9982E"
                    android:layout_centerVertical="true"
                    android:alpha="0.3"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senzakwenzeke"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:fontFamily="serif"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DECOR &amp; CATERING"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.3"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="#C9982E"
            android:layout_marginTop="16dp"/>

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="40dp"
            android:indeterminateTint="#FFD700"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:text="Est. 2024 • Bothas Hill • Durban"
        android:textColor="#8A9CC5"
        android:textSize="10sp"
        android:letterSpacing="0.1"/>

</RelativeLayout>